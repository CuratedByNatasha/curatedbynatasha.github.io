body {
  margin: 0;
  font-family: Arial, sans-serif;
  background: #f8f5f0;
  color: #333;
}

/* NAV */
.nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20px 40px;
  background: rgba(255,255,255,0.8);
  backdrop-filter: blur(10px);
  position: sticky;
  top: 0;
}

.nav a {
  margin-left: 15px;
  text-decoration: none;
  color: #333;
  font-size: 14px;
}

/* HERO */
.hero {
  height: 80vh;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  background: linear-gradient(to bottom, #d8e3dc, #f8f5f0);
  padding: 20px;
}

.hero h1 {
  font-size: 48px;
}

.hero p {
  color: #666;
  margin-top: 10px;
}

.btn {
  display: inline-block;
  margin-top: 20px;
  padding: 12px 24px;
  background: #2f4a3a;
  color: white;
  text-decoration: none;
  border-radius: 8px;
}

/* CATEGORIES */
.categories {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
  gap: 15px;
  padding: 40px;
}

.card {
  background: white;
  padding: 30px;
  text-align: center;
  border-radius: 12px;
  text-decoration: none;
  color: #333;
  transition: 0.3s;
}

.card:hover {
  transform: translateY(-5px);
}

/* FOOTER */
footer {
  text-align: center;
  padding: 30px;
  font-size: 12px;
  color: #888;
}
